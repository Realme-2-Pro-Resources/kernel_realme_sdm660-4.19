# Realme 2 Pro (RMX1801) on top of vendor/sdm660-perf_defconfig
CONFIG_MACH_REALME_RMX1801=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y

# Charging: the OPPO charger replaces qpnp-smb2/smb-lib, no parallel charger
CONFIG_OPPO_MSM8998P_CHARGER=y
CONFIG_OPPO_RTC_DET_SUPPORT=y
CONFIG_OPPO_CHECK_CHARGERID_VOLT=y
CONFIG_OPPO_SHIP_MODE_SUPPORT=y
CONFIG_FORCE_FAST_CHARGE=y
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_QPNP_QNOVO5 is not set

# OPPO platform drivers
CONFIG_OPPO_COMMON_SOFT=y
CONFIG_OPPO_DEVICE_IFNO=y
CONFIG_OPPO_FINGERPRINT=y
CONFIG_OPPO_FINGERPRINT_QCOM=y
CONFIG_TOUCHPANEL_OPPO=y
CONFIG_TOUCHPANEL_MULTI_NOFLASH=y
CONFIG_TOUCHPANEL_NOVA=y
CONFIG_TOUCHPANEL_HIMAX=y
CONFIG_TOUCHPANEL_NOVA_NT36672_NOFLASH=y
CONFIG_TOUCHPANEL_HIMAX_HX83112A_NOFLASH=y

# WLAN
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"

# pstore/ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Misc
CONFIG_FB_MODE_HELPERS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_UTF8=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
